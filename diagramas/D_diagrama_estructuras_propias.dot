digraph D_diagrama_estructuras_propias {
  graph [fontname="DejaVu Sans", fontsize=18, label="Diagrama de estructuras de datos propias (genéricas, sin java.util)", labelloc=t, rankdir=TB,
         splines=true, nodesep=0.45, ranksep=0.75, pad=0.4, bgcolor="white" , ranksep=0.9, nodesep=0.4];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#444444", labeldistance=2.2, labelangle=-25];
  Iterable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F5F5D5"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Iterable&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+iterator(): Iterator&lt;T&gt;</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ListaEnlazada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ListaEnlazada&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-cabeza: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-cola: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-tamanio: int</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+agregarInicio(T)   +agregarFinal(T)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+insertar(int, T)   +obtener(int): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+primero(): T   +ultimo(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+eliminar(T): boolean   +eliminarEn(int): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+eliminarPrimero(): T   +eliminarUltimo(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+contiene(T)   +indiceDe(T): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator()   +iteradorInverso()</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• historial de estancias del huésped</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• ocupantes de una reserva</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• desglose de noches liquidadas</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• movimientos del folio</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NodoLE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="9">«clase interna»</FONT><BR/><B>Nodo&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">dato: T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">sig: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">ant: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Cola [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>Cola&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-frente: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-fin: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-tamanio: int</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+encolar(T)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+desencolar(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+frente(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+estaVacia(): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator()</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• solicitudes del canal externo (FIFO)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• recorrido BFS del grafo</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NodoC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="9">«clase interna»</FONT><BR/><B>Nodo&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">dato: T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">sig: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Pila [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>Pila&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-cima: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-tamanio: int</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+apilar(T)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+desapilar(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+cima(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+estaVacia(): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator()</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• deshacer la última operación del folio</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• navegación «Atrás» entre pantallas</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NodoP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="9">«clase interna»</FONT><BR/><B>Nodo&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">dato: T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">sig: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ColaPrioridad [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ColaPrioridad&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-heap: Object[]   (montículo binario)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-tamanio: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-comparador: Comparator&lt;? super T&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+insertar(T)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+extraer(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+verMinimo(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+eliminar(T): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator()   «en orden de prioridad»</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• cola de preparación (entrada hoy primero)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• reservas Pendientes por vencimiento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• Dijkstra  • orden de resultados de búsqueda</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ABB [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ArbolBinarioBusqueda&lt;T extends Comparable&lt;T&gt;&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-raiz: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-tamanio: int</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+insertar(T): boolean   «recursivo»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+buscar(T): T   «recursivo»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+eliminar(T): boolean   «recursivo»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+altura(): int   «recursivo»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+inOrden() / preOrden() / postOrden(): ListaEnlazada&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+getRaiz(): Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator()   «in-orden»</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• catálogo de apartamentos (por código)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• huéspedes (por documento)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• empleados (por documento)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• reservas de cada apartamento (por fecha de entrada)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  → detección de solapamientos recursiva</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NodoABB [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="9">«clase interna»</FONT><BR/><B>Nodo&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">dato: T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">izq: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">der: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Grafo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>Grafo&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-vertices: ListaEnlazada&lt;Vertice&lt;T&gt;&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+agregarVertice(T)   +eliminarVertice(T)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+agregarArista(a, b, peso)   +eliminarArista(a, b)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+bfs(T): ListaEnlazada&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+dfs(T): ListaEnlazada&lt;T&gt;   «recursivo»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+componentesConexas()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+inalcanzablesSiSeCierra(origen, a, b)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+dijkstra(origen, destino): Ruta&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+rutaPorDestinos(origen, destinos, respetarOrden)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• mapa del edificio: apartamentos, recepción,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  escaleras y cuartos de aseo (nodos)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• pasillos con peso en metros (aristas)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• ruta de preparación (Dijkstra) y análisis de cierres</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Vertice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="9">«clase interna»</FONT><BR/><B>Vertice&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">dato: T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">indice: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">adyacentes: ListaEnlazada&lt;Arista&lt;T&gt;&gt;</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Arista [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="9">«clase interna»</FONT><BR/><B>Arista&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">destino: Vertice&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">peso: double</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Conjunto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>Conjunto&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-elementos: ListaEnlazada&lt;T&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+agregar(T): boolean   «sin repetidos»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+eliminar(T)   +contiene(T)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+union(Conjunto&lt;T&gt;)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+interseccion(Conjunto&lt;T&gt;)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator()</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• apartamentos favoritos de cada huésped</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ListaCircular [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ListaCircular&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-ultimo: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-actual: Nodo&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-tamanio: int</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+agregar(T)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+actual(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+rotar(): T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+eliminar(T): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator()   «una vuelta»</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Uso en el SGA:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">• rotación de turnos de los recepcionistas</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NodoLC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="9">«clase interna»</FONT><BR/><B>Nodo&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">dato: T</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">sig: Nodo&lt;T&gt;  (el último apunta al primero)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Ruta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Ruta&lt;T&gt;</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">camino: ListaEnlazada&lt;T&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">distancia: double</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Vacia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F7D4D4"><FONT POINT-SIZE="9">«extends RuntimeException»</FONT><BR/><B>EstructuraVaciaException</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Se lanza al desencolar, desapilar, extraer</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">o consultar una estructura sin elementos</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ListaEnlazada -> Iterable [arrowhead=onormal, style=dashed];
  Cola -> Iterable [arrowhead=onormal, style=dashed];
  Pila -> Iterable [arrowhead=onormal, style=dashed];
  ColaPrioridad -> Iterable [arrowhead=onormal, style=dashed];
  ABB -> Iterable [arrowhead=onormal, style=dashed];
  Grafo -> Iterable [arrowhead=onormal, style=dashed];
  Conjunto -> Iterable [arrowhead=onormal, style=dashed];
  ListaCircular -> Iterable [arrowhead=onormal, style=dashed];
  ListaEnlazada -> NodoLE [dir=back, arrowtail=diamond, headlabel="0..*"];
  Cola -> NodoC [dir=back, arrowtail=diamond, headlabel="0..*"];
  Pila -> NodoP [dir=back, arrowtail=diamond, headlabel="0..*"];
  ABB -> NodoABB [dir=back, arrowtail=diamond, headlabel="0..*"];
  ListaCircular -> NodoLC [dir=back, arrowtail=diamond, headlabel="1..*"];
  Grafo -> Vertice [dir=back, arrowtail=diamond, headlabel="0..*"];
  Vertice -> Arista [dir=back, arrowtail=diamond, headlabel="0..*"];
  Arista -> Vertice [arrowhead=vee, label="destino"];
  Conjunto -> ListaEnlazada [dir=back, arrowtail=diamond];
  Grafo -> ListaEnlazada [arrowhead=vee, style=dashed, label="recorridos"];
  Grafo -> Cola [arrowhead=vee, style=dashed, label="BFS"];
  Grafo -> ColaPrioridad [arrowhead=vee, style=dashed, label="Dijkstra"];
  Grafo -> Ruta [arrowhead=vee, style=dashed];
  ABB -> ListaEnlazada [arrowhead=vee, style=dashed, label="recorridos"];
  Cola -> Vacia [arrowhead=vee, style=dashed, constraint=false, color="#B04040"];
  Pila -> Vacia [arrowhead=vee, style=dashed, constraint=false, color="#B04040"];
  ColaPrioridad -> Vacia [arrowhead=vee, style=dashed, constraint=false, color="#B04040"];
  ListaEnlazada -> Vacia [arrowhead=vee, style=dashed, constraint=false, color="#B04040"];
  ListaCircular -> Vacia [arrowhead=vee, style=dashed, constraint=false, color="#B04040"];
}
