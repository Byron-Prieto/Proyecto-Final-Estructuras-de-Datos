digraph C_diagrama_clases_gui {
  graph [fontname="DejaVu Sans", fontsize=18, label="Diagrama de clases — Interfaz gráfica (Swing)", labelloc=t, rankdir=TB,
         splines=true, nodesep=0.45, ranksep=0.75, pad=0.4, bgcolor="white" , ranksep=0.9, nodesep=0.3];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#444444", labeldistance=2.2, labelangle=-25];
  Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><B>Main</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+main(String[])</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  VentanaPrincipal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><FONT POINT-SIZE="9">«JFrame»</FONT><BR/><B>VentanaPrincipal</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-pestanas: JTabbedPane</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-historial: Pila&lt;Integer&gt;   (navegación «Atrás»)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-atras()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-cargarEjemplo() / cargarArchivo()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+refrescar()</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Timer: cancela reservas pendientes vencidas</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Contexto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><B>Contexto</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-aloj: Alojamiento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-reloj: RelojAjustable</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-ruta: Ruta&lt;String&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+aloj(): Alojamiento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+reemplazar(Alojamiento)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+refrescar()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+ejecutar(Component, Runnable)  «guarda tras cada operación»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+guardar()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iniciarDesdeArchivo(): String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+error(Component, Exception)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Estado compartido entre los paneles</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Actualizable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F5F5D5"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Actualizable</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+actualizar()</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Implementada por los 8 paneles</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">(cada uno se redibuja con el estado actual)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TableroPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>TableroPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Inicio: tablero de apartamentos por estado (verde/azul/amarillo/rojo)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TableroPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> TableroPanel [dir=back, arrowtail=diamond];
  ReservasPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>ReservasPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Disponibilidad, reservas, folio, check-in/out, canal externo</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ReservasPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> ReservasPanel [dir=back, arrowtail=diamond];
  CalendarioPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>CalendarioPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Cuadrícula apartamentos × noches del mes</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CalendarioPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> CalendarioPanel [dir=back, arrowtail=diamond];
  UsuarioPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>UsuarioPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Huésped: perfil, reservas, saldo, favoritos, historial</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  UsuarioPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> UsuarioPanel [dir=back, arrowtail=diamond];
  PreparacionPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>PreparacionPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Cola de preparación y ruta sugerida</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PreparacionPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> PreparacionPanel [dir=back, arrowtail=diamond];
  MapaPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>MapaPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Grafo interactivo del edificio y rutas (Dijkstra)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  MapaPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> MapaPanel [dir=back, arrowtail=diamond];
  EstadisticasPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>EstadisticasPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Ocupación, ingresos, canales, conflictos, preparación</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EstadisticasPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> EstadisticasPanel [dir=back, arrowtail=diamond];
  AdminPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel, Actualizable»</FONT><BR/><B>AdminPanel</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Apartamentos, huéspedes, empleados, temporadas, mapa</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AdminPanel -> Contexto [arrowhead=vee];
  VentanaPrincipal -> AdminPanel [dir=back, arrowtail=diamond];
  Dialogos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F0E0"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>Dialogos</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+fecha(String)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+ocupantes(String)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+nuevoHuesped(...)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+cotizacion(...)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+folio(...)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Estilo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F0E0"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>Estilo</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+colorEstado(EstadoApartamento): Color</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+tabla(...)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+boton(...)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+dinero(double): String</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Colores de estado y componentes comunes</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GraficoBarras [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel»</FONT><BR/><B>GraficoBarras</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+setDatos(String[], double[])</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Lienzo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCEBFA"><FONT POINT-SIZE="9">«JPanel»</FONT><BR/><B>Lienzo (clase interna de MapaPanel)</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-nombres, x, y: disposición de nodos</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-ea, eb, ep: pasillos</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+reorganizar()   «Fruchterman–Reingold»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">#paintComponent(Graphics)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">arrastre de nodos con el mouse</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Alojamiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><FONT POINT-SIZE="9">«servicio»</FONT><BR/><B>Alojamiento</B></TD></TR></TABLE>>];
  Main -> VentanaPrincipal [arrowhead=vee, style=dashed, label="crea"];
  VentanaPrincipal -> Contexto [arrowhead=vee];
  Contexto -> Alojamiento [arrowhead=vee, headlabel="1"];
  MapaPanel -> Lienzo [dir=back, arrowtail=diamond];
  EstadisticasPanel -> GraficoBarras [dir=back, arrowtail=diamond, headlabel="3"];
  ReservasPanel -> Dialogos [arrowhead=vee, style=dashed];
  UsuarioPanel -> Dialogos [arrowhead=vee, style=dashed];
  AdminPanel -> Dialogos [arrowhead=vee, style=dashed];
}
