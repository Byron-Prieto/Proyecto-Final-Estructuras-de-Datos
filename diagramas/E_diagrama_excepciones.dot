digraph E_diagrama_excepciones {
  graph [fontname="DejaVu Sans", fontsize=18, label="Excepciones propias del SGA", labelloc=t, rankdir=LR,
         splines=true, nodesep=0.45, ranksep=0.75, pad=0.4, bgcolor="white" , ranksep=1.2, nodesep=0.35];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#444444", labeldistance=2.2, labelangle=-25];
  RuntimeException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F5F5D5"><FONT POINT-SIZE="9">«java.lang»</FONT><BR/><B>RuntimeException</B></TD></TR></TABLE>>];
  ReservaSolapadaException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F7D4D4"><B>ReservaSolapadaException</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Dos reservas activas comparten una noche</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Lanzada por:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Apartamento.agregarReserva</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Alojamiento.crearReserva</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ReservaSolapadaException -> RuntimeException [arrowhead=onormal];
  CapacidadExcedidaException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F7D4D4"><B>CapacidadExcedidaException</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Más ocupantes que la capacidad</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Lanzada por:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Reserva (constructor)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Alojamiento.asignarGrupo</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Alojamiento.actualizarApartamento</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CapacidadExcedidaException -> RuntimeException [arrowhead=onormal];
  FechasInvalidasException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F7D4D4"><B>FechasInvalidasException</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Salida no posterior a entrada, fechas nulas,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">periodos de temporada cruzados</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Lanzada por:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Estancia (constructor)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  CalendarioTemporadas.definir</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Alojamiento.crearReserva / checkIn</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FechasInvalidasException -> RuntimeException [arrowhead=onormal];
  TransicionEstadoInvalidaException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F7D4D4"><B>TransicionEstadoInvalidaException</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Cambio de estado no permitido</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Lanzada por:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Apartamento.cambiarEstado</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Reserva.cambiarEstado</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Alojamiento.checkIn</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TransicionEstadoInvalidaException -> RuntimeException [arrowhead=onormal];
  EstructuraVaciaException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F7D4D4"><B>EstructuraVaciaException</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Extraer/consultar de una estructura vacía</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Lanzada por:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Cola, Pila, ColaPrioridad,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  ListaEnlazada, ListaCircular</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EstructuraVaciaException -> RuntimeException [arrowhead=onormal];
  ApartamentoNoPreparadoException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F7D4D4"><B>ApartamentoNoPreparadoException</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Check-in con apartamento no Preparado</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Lanzada por:</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">  Alojamiento.checkIn</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ApartamentoNoPreparadoException -> RuntimeException [arrowhead=onormal];
}
