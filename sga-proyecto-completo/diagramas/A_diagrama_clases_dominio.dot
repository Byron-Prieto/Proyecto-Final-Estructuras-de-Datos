digraph A_diagrama_clases_dominio {
  graph [fontname="DejaVu Sans", fontsize=18, label="Diagrama de clases — Modelo de dominio del SGA", labelloc=t, rankdir=TB,
         splines=true, nodesep=0.45, ranksep=0.75, pad=0.4, bgcolor="white" , ranksep=0.9, nodesep=0.55];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#444444", labeldistance=2.2, labelangle=-25];
  Apartamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Apartamento</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-codigo: String {id}</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-nombre: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-bloque: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-piso: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-dormitorios: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-capacidad: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-caracteristicas: ListaEnlazada&lt;String&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-tarifas: double[] (una por Temporada)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-estado: EstadoApartamento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-motivoFueraDeServicio: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-reservas: ArbolBinarioBusqueda&lt;Reserva&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-totalReservas: int</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+cambiarEstado(EstadoApartamento)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+ponerFueraDeServicio(motivo: String)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+buscarConflicto(Estancia): Reserva   «recursivo»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+estaLibre(Estancia): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+agregarReserva(Reserva)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+liberarReserva(Reserva): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+getTarifa(Temporada): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+compareTo(Apartamento): int   «por código»</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Huesped [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Huesped</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-documento: String {id}</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-nombre: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-fechaNacimiento: LocalDate</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-telefono: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-correo: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-fotografia: String  (opcional)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-favoritos: Conjunto&lt;Apartamento&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-historial: ListaEnlazada&lt;Reserva&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+agregarFavorito(Apartamento): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+quitarFavorito(Apartamento): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+agregarAlHistorial(Reserva)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+compareTo(Huesped): int   «por documento»</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Reserva [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Reserva</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-id: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-estado: EstadoReserva</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-canal: Canal</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-creadaEn: LocalDateTime</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-horaLlegadaEstimada: LocalTime</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-ocupantes: ListaEnlazada&lt;Ocupante&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+PORCENTAJE_ANTICIPO = 0.30</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+HORAS_VENCIMIENTO = 24</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+cambiarEstado(EstadoReserva)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+pagantes(): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+getVencimiento(): LocalDateTime</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+anticipoRequerido(total: double): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+calcularReembolso(hoy: LocalDate): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+compareTo(Reserva): int   «por fecha de entrada»</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Estancia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Estancia</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-entrada: LocalDate</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-salida: LocalDate  (no se cobra)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+noches(): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+solapa(Estancia): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+incluyeNoche(LocalDate): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+iterator(): Iterator&lt;LocalDate&gt;   «una por noche»</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Ocupante [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Ocupante</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-nombre: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-fechaNacimiento: LocalDate</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+EDAD_MINIMA_PAGO = 6</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+edadEn(LocalDate): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+pagaEn(LocalDate): boolean</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Folio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Folio</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-movimientos: ListaEnlazada&lt;Movimiento&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-operaciones: Pila&lt;Movimiento&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+registrarCargo(monto, concepto): Movimiento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+registrarPago(monto, concepto): Movimiento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+deshacer(): Movimiento   «registra el contrario»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+saldo(): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+totalCargos(): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+totalPagado(): double</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Movimiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><FONT POINT-SIZE="9">«inmutable»</FONT><BR/><B>Movimiento</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-tipo: TipoMovimiento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-monto: double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-concepto: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-fecha: LocalDateTime</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TareaPreparacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>TareaPreparacion</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-entradaHoy: boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-horaLlegada: LocalTime</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-encoladoEn: LocalDateTime</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-inicio: LocalDateTime</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-fin: LocalDateTime</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+isEntradaHoy(): boolean</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Elemento de la cola de preparación</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Empleado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Empleado</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-documento: String {id}</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-nombre: String</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+compareTo(Empleado): int   «por documento»</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CalendarioTemporadas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>CalendarioTemporadas</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-periodos: ListaEnlazada&lt;Periodo&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+definir(inicio, fin, Temporada)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+eliminar(Periodo): boolean</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+temporadaDe(LocalDate): Temporada</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Periodo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Periodo</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">inicio: LocalDate</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">fin: LocalDate  (inclusive)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Liquidador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F0E0"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>Liquidador</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+liquidar(Apartamento, Estancia, pagantes, CalendarioTemporadas)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">      : ListaEnlazada&lt;LineaLiquidacion&gt;   «recursivo»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+total(ListaEnlazada&lt;LineaLiquidacion&gt;): double</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Usa: Apartamento (tarifas), Estancia (Iterator),</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">CalendarioTemporadas → produce LineaLiquidacion</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LineaLiquidacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>LineaLiquidacion</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">noche: LocalDate</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">tarifa: double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">pagantes: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">valor: double</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Comparadores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F0E0"><FONT POINT-SIZE="9">«utilidad  (Comparator)»</FONT><BR/><B>Comparadores</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+apartamentosPorPrecio(Temporada)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+apartamentosPorCapacidad()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+apartamentosPorDormitorios()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+apartamentosPorNumeroReservas()</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+prioridadPreparacion()   «thenComparing»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+reservasPorVencimiento()</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Ordena: Apartamento, TareaPreparacion, Reserva</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PoliticaCancelacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F0E0"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>PoliticaCancelacion</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+porcentajeReembolso(hoy, entrada): double</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Usada por Reserva.calcularReembolso</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">Supuesto: ≥7 días 100 %, 3–6 días 50 %, menos 0 %</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EstadoApartamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E6DCF5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoApartamento</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">PREPARADO</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">OCUPADO</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">PENDIENTE_PREPARACION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">EN_PREPARACION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">FUERA_DE_SERVICIO</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EstadoReserva [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E6DCF5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoReserva</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">PENDIENTE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">CONFIRMADA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">EN_CURSO</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">FINALIZADA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">CANCELADA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">NO_SHOW</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Temporada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E6DCF5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Temporada</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">BAJA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">MEDIA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">ALTA</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Canal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E6DCF5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Canal</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">PORTAL</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">DIRECTA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">EXTERNA</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TipoMovimiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E6DCF5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoMovimiento</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">CARGO</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">PAGO</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">ANULACION_CARGO</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">ANULACION_PAGO</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E6DCF5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Rol</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">RECEPCIONISTA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">ADMINISTRADOR</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Comparable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F5F5D5"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Comparable&lt;T&gt;</B></TD></TR></TABLE>>];
  Iterable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F5F5D5"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Iterable&lt;T&gt;</B></TD></TR></TABLE>>];
  Apartamento -> Comparable [arrowhead=onormal, style=dashed];
  Huesped -> Comparable [arrowhead=onormal, style=dashed];
  Reserva -> Comparable [arrowhead=onormal, style=dashed];
  Empleado -> Comparable [arrowhead=onormal, style=dashed];
  Estancia -> Iterable [arrowhead=onormal, style=dashed];
  Huesped -> Reserva [arrowhead=none, label="titular / historial", taillabel="1", headlabel="0..*"];
  Huesped -> Apartamento [arrowhead=vee, label="favoritos", headlabel="0..*"];
  Apartamento -> Reserva [dir=back, arrowtail=odiamond, label="reservas activas\n(árbol por fecha de entrada)", taillabel="1", headlabel="0..*"];
  Reserva -> Estancia [dir=back, arrowtail=diamond, headlabel="1"];
  Reserva -> Ocupante [dir=back, arrowtail=diamond, headlabel="1..*"];
  Reserva -> Folio [dir=back, arrowtail=diamond, headlabel="1"];
  Folio -> Movimiento [dir=back, arrowtail=diamond, headlabel="0..*"];
  TareaPreparacion -> Apartamento [arrowhead=vee, headlabel="1"];
  CalendarioTemporadas -> Periodo [dir=back, arrowtail=diamond, headlabel="0..*"];
  Reserva -> EstadoReserva [arrowhead=vee];
  Reserva -> Canal [arrowhead=vee];
  Apartamento -> EstadoApartamento [arrowhead=vee];
  Apartamento -> Temporada [arrowhead=vee, label="tarifa por", headlabel="3"];
  Periodo -> Temporada [arrowhead=vee];
  Movimiento -> TipoMovimiento [arrowhead=vee];
  Empleado -> Rol [arrowhead=vee];
  LineaLiquidacion -> Temporada [arrowhead=vee];
}
