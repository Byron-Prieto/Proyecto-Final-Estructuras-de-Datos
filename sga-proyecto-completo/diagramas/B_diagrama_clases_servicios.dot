digraph B_diagrama_clases_servicios {
  graph [fontname="DejaVu Sans", fontsize=18, label="Diagrama de clases — Servicios y reglas de negocio", labelloc=t, rankdir=LR,
         splines=true, nodesep=0.45, ranksep=0.75, pad=0.4, bgcolor="white" , ranksep=1.3, nodesep=0.3];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#444444", labeldistance=2.2, labelangle=-25];
  Alojamiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><FONT POINT-SIZE="9">«fachada, Serializable»</FONT><BR/><B>Alojamiento</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-reloj: Clock</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-catalogo: ArbolBinarioBusqueda&lt;Apartamento&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-huespedes: ArbolBinarioBusqueda&lt;Huesped&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-empleados: ArbolBinarioBusqueda&lt;Empleado&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-mapa: Grafo&lt;String&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-calendario: CalendarioTemporadas</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-reservas: ListaEnlazada&lt;Reserva&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-colaPreparacion: ColaPrioridad&lt;TareaPreparacion&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-pendientes: ColaPrioridad&lt;Reserva&gt;   (por vencimiento)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-solicitudes: Cola&lt;SolicitudExterna&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-turnos: ListaCircular&lt;Empleado&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-conflictos: ListaEnlazada&lt;ConflictoCanal&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-enPreparacion, preparadas: ListaEnlazada&lt;TareaPreparacion&gt;</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+buscarDisponibles(Estancia, personas, Comparator&lt;Apartamento&gt;): ListaEnlazada&lt;Apartamento&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+cotizar(Apartamento, Estancia, ocupantes): ListaEnlazada&lt;LineaLiquidacion&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+crearReserva(Huesped, Apartamento, Estancia, ocupantes, Canal): Reserva</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+pagarAnticipo(Reserva): double      +pagarReserva(Reserva, monto, concepto)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+reembolsoSiCancela(Reserva): double  +cancelarReserva(Reserva): double  +marcarNoShow(Reserva)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+procesarVencimientos(): ListaEnlazada&lt;Reserva&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+checkIn(Reserva)      +checkOut(Reserva)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+despacharPreparacion(): TareaPreparacion   +terminarPreparacion(Apartamento)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+rutaPreparacion(): Ruta&lt;String&gt;   «Dijkstra»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+recibirSolicitudExterna(...)   +procesarSiguienteSolicitud(): ResultadoSolicitud</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+asignarGrupo(Estancia, personas): ListaEnlazada&lt;Apartamento&gt;   «backtracking»</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+reservarGrupo(...): ListaEnlazada&lt;Reserva&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+inalcanzablesSiSeCierra(a, b)   +agruparPorBloque()   +estadoNoche(Apartamento, LocalDate)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+registrarApartamento / actualizarApartamento / eliminarApartamento</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+registrarHuesped / eliminarHuesped   +registrarEmpleado / eliminarEmpleado</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+definirTemporada(...)   +turnoActual()   +rotarTurno()</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Reportes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><B>Reportes</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+nochesOcupadas(Apartamento, desde, hasta): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+porcentajeOcupacion(...): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+nochesPorTemporada(): int[]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+ingresos(desde, hasta): double</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+reservasPorCanal(Canal): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+reservasPorCanalYEstado(Canal, EstadoReserva): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+conflictosDeCanal(): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+tiempoPromedioPreparacionMinutos(): double</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CargadorDatos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F0E0"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>CargadorDatos</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+cargar(Alojamiento, Path): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+cargar(Alojamiento, Reader): int</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Lee el archivo plano de escenario (datos/escenario.txt)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Persistencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8F0E0"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>Persistencia</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+guardar(Alojamiento, Path)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+cargar(Path, Clock): Alojamiento</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Serialización de Java: guarda todo el estado</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#7A4B00">en datos/sga.dat (escritura atómica, hilo con pila grande)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SolicitudExterna [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><B>SolicitudExterna</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-documento, nombre: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-codigoApartamento: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-estancia: Estancia</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-ocupantes: ListaEnlazada&lt;Ocupante&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">-recibidaEn: LocalDateTime</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ConflictoCanal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>ConflictoCanal</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">solicitud: SolicitudExterna</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">motivo: String</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">fecha: LocalDateTime</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ResultadoSolicitud [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>ResultadoSolicitud</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">solicitud: SolicitudExterna</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">reserva: Reserva</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">motivoRechazo: String</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+aceptada(): boolean</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EstadoNoche [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoNoche</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">LIBRE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">OCUPADA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">BLOQUEADA</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Clock [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#F5F5D5"><FONT POINT-SIZE="9">«java.time»</FONT><BR/><B>Clock</B></TD></TR></TABLE>>];
  RelojAjustable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FAD9C1"><B>RelojAjustable</B></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">-desfase: Duration</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+enMarcha(): RelojAjustable</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">+avanzar(Duration)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD SIDES="T" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF4D6"><FONT POINT-SIZE="8" COLOR="#7A4B00">Permite adelantar el tiempo en la demostración</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Apartamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Apartamento</B></TD></TR></TABLE>>];
  Huesped [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Huesped</B></TD></TR></TABLE>>];
  Reserva [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Reserva</B></TD></TR></TABLE>>];
  Empleado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>Empleado</B></TD></TR></TABLE>>];
  TareaPreparacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>TareaPreparacion</B></TD></TR></TABLE>>];
  CalendarioTemporadas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE6F5"><B>CalendarioTemporadas</B></TD></TR></TABLE>>];
  ABB [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ArbolBinarioBusqueda&lt;T&gt;</B></TD></TR></TABLE>>];
  Grafo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>Grafo&lt;T&gt;</B></TD></TR></TABLE>>];
  CP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ColaPrioridad&lt;T&gt;</B></TD></TR></TABLE>>];
  Cola [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>Cola&lt;T&gt;</B></TD></TR></TABLE>>];
  LC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ListaCircular&lt;T&gt;</B></TD></TR></TABLE>>];
  LE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#D5EFE3"><B>ListaEnlazada&lt;T&gt;</B></TD></TR></TABLE>>];
  Alojamiento -> ABB [dir=back, arrowtail=diamond, label="catalogo, huespedes,\nempleados", headlabel="3"];
  Alojamiento -> Grafo [dir=back, arrowtail=diamond, label="mapa"];
  Alojamiento -> CP [dir=back, arrowtail=diamond, label="colaPreparacion,\npendientes", headlabel="2"];
  Alojamiento -> Cola [dir=back, arrowtail=diamond, label="solicitudes"];
  Alojamiento -> LC [dir=back, arrowtail=diamond, label="turnos"];
  Alojamiento -> LE [dir=back, arrowtail=diamond, label="reservas, conflictos,\npreparadas..."];
  Alojamiento -> CalendarioTemporadas [dir=back, arrowtail=diamond];
  Alojamiento -> Apartamento [dir=back, arrowtail=odiamond, headlabel="0..*"];
  Alojamiento -> Huesped [dir=back, arrowtail=odiamond, headlabel="0..*"];
  Alojamiento -> Reserva [dir=back, arrowtail=odiamond, headlabel="0..*"];
  Alojamiento -> Empleado [dir=back, arrowtail=odiamond, headlabel="0..*"];
  Alojamiento -> TareaPreparacion [dir=back, arrowtail=odiamond, headlabel="0..*"];
  Alojamiento -> SolicitudExterna [arrowhead=vee, style=dashed];
  Alojamiento -> ConflictoCanal [arrowhead=vee, style=dashed];
  Alojamiento -> ResultadoSolicitud [arrowhead=vee, style=dashed];
  Alojamiento -> EstadoNoche [arrowhead=vee, style=dashed];
  Alojamiento -> Clock [arrowhead=vee, label="reloj"];
  RelojAjustable -> Clock [arrowhead=onormal];
  Reportes -> Alojamiento [arrowhead=vee, headlabel="1"];
  CargadorDatos -> Alojamiento [arrowhead=vee, style=dashed];
  Persistencia -> Alojamiento [arrowhead=vee, style=dashed];
  SolicitudExterna -> ConflictoCanal [dir=back, arrowtail=odiamond];
}
